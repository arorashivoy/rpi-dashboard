[Unit]
Description=zrok public share for Pi Control Room
Requires=rpi-dashboard.service
After=rpi-dashboard.service
PartOf=rpi-dashboard.service

[Service]
Type=simple
WorkingDirectory=%h/projects/rpi-dashboard
EnvironmentFile=%h/.config/rpi-dashboard-zrok.env
ExecStart=/usr/bin/env zrok share public http://127.0.0.1:8787 --name-selection public:pi-dashboard --basic-auth=${ZROK_BASIC_AUTH} --headless
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target