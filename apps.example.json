{
    "cloudflare": {
        "domain": "arorashivoy.win"
    },
    "apps": [
        {
            "id": "rpi-dashboard",
            "name": "Raspberry Pi Dashboard",
            "description": "Service status and application addresses",
            "kind": "systemd",
            "scope": "user",
            "unit": "rpi-dashboard.service",
            "port": 8787,
            "url": "http://127.0.0.1:8787",
            "managed": false,
            "cloudflare": {
                "subdomain": "dashboard",
                "visibility": "private"
            }
        },
        {
            "id": "two-rooms",
            "name": "Two Rooms and a Boom",
            "description": "Game server",
            "kind": "command",
            "working_dir": "/home/pi/apps/two-rooms-and-a-boom",
            "start": [],
            "stop": {
                "signal": "SIGINT"
            },
            "port": 5001,
            "autostart": true,
            "cloudflare": {
                "subdomain": "two-rooms",
                "visibility": "public"
            }
        },
        {
            "id": "block-logic-puzzle",
            "name": "Block Logic Puzzle",
            "description": "Puzzle application",
            "kind": "command",
            "working_dir": "/home/pi/apps/block-logic-puzzle",
            "start": [],
            "stop": {
                "signal": "SIGINT"
            },
            "port": 4173,
            "autostart": true,
            "cloudflare": {
                "subdomain": "block-logic",
                "visibility": "private"
            }
        },
        {
            "id": "pihole",
            "name": "Pi-hole",
            "description": "DNS and network filtering",
            "kind": "docker",
            "container": "pihole",
            "port": 8081,
            "url": "http://127.0.0.1:8081/admin/",
            "autostart": true
        },
        {
            "id": "waypoint",
            "name": "Waypoint",
            "description": "Job search workspace",
            "kind": "command",
            "working_dir": "/home/pi/apps/waypoint",
            "start": [],
            "stop": {
                "signal": "SIGINT"
            },
            "port": 3118,
            "autostart": true,
            "cloudflare": {
                "subdomain": "waypoint",
                "visibility": "private"
            }
        }
    ]
}
